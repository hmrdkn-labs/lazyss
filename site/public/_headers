# no-transform: the zone injects Cloudflare's Web Analytics beacon into HTML. This page carries no
# analytics, and no-transform is the opt-out that lives in this Worker rather than in zone settings.
# Cost: Cloudflare no longer compresses the responses (index.html is about 19 KB).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cache-Control: no-transform

# File names carry no hash: rename a file when its content changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
